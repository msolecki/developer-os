filters:
  and:
    - file.ext == "md"
    - status == "active"
    - not:
        - file.inFolder("templates")
properties:
  file.name:
    displayName: Note
views:
  - type: table
    name: By project
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - type
      - updated
      - summary
